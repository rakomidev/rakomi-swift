{
  "description": "Conformance vectors for the Rakomi publisher-webhook receiver (Standard Webhooks HMAC-SHA256) shared by every Rakomi SDK.",
  "$schema": "publisher-webhook-verify-vectors/v1",
  "error_classes": [
    "invalid_signature",
    "invalid_secret",
    "missing_header",
    "timestamp_too_old",
    "timestamp_too_new",
    "invalid_body"
  ],
  "notes": {
    "now_override": "unix seconds — the verifier MUST treat THIS as \"now\" (pin the clock) for freshness.",
    "tolerance": "replay window in seconds (300 default, 600 max clamp).",
    "secret": "rksec_<base64url> signing secret; non-rksec_ is rejected by the publisher entry point.",
    "signature_alphabet": "the SECRET is base64url (-/_); the SIGNATURE is standard base64 (+//)."
  },
